{
  "name": "juan-lopez-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/astro-cli.mjs dev",
    "dev:container": "node scripts/astro-cli.mjs dev --host 0.0.0.0",
    "dev:agent": "node scripts/astro-cli.mjs dev --background",
    "dev:status": "node scripts/astro-cli.mjs dev status",
    "dev:logs": "node scripts/astro-cli.mjs dev logs",
    "dev:logs:follow": "node scripts/astro-cli.mjs dev logs --follow",
    "dev:stop": "node scripts/astro-cli.mjs dev stop",
    "dev:info": "node scripts/astro-cli.mjs info",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "debug:build": "ASTRO_TELEMETRY_DISABLED=1 astro build --devOutput",
    "preview": "astro preview --host 0.0.0.0 --port 4322",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check --minimumFailingSeverity warning",
    "check:watch": "astro check --watch --minimumFailingSeverity warning",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:project": "node scripts/verify-project.mjs",
    "verify": "npm run audit:prod && npm run build && npm run test:project",
    "security:check": "npm run verify",
    "zip": "bash scripts/zip_project.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Juan Lopez Portfolio"
}
