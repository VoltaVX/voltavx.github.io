---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Resume — Juan Lopez"
  description="Experience overview for Juan Lopez, behavior analyst, researcher, and digital systems designer."
>
  <header class="page-hero">
    <div class="page-shell page-hero__inner">
      <p class="eyebrow">Resume</p>
      <h1>Experience overview.</h1>
      <p class="page-hero__lede">
        A concise public summary of confirmed research, client systems, and independent commerce work. A downloadable resume can be added when the final PDF is supplied.
      </p>
    </div>
  </header>

  <section class="section--tight">
    <div class="page-shell case-layout">
      <aside class="case-meta">
        <dl>
          <div><dt>Primary identity</dt><dd>Behavior Analyst</dd></div>
          <div><dt>Credential</dt><dd>Registered Behavior Technician</dd></div>
          <div><dt>Supporting work</dt><dd>Research and digital systems</dd></div>
          <div><dt>Platforms</dt><dd>SitePad and Shopify</dd></div>
          <div><dt>Research tools</dt><dd>Qualtrics and IBM SPSS</dd></div>
        </dl>
        <a class="button button--secondary" href="mailto:voltavxofficial@gmail.com">Request a resume</a>
      </aside>
      <div>
        <ol class="resume-list">
          <li>
            <p class="eyebrow">Expected 2027</p>
            <h3>Florida International University</h3>
            <p>B.A. Psychology, Applied Behavior Analysis Track, and B.A. Natural and Applied Sciences. Associate Degree completed in June 2025.</p>
          </li>
          <li>
            <p class="eyebrow">Credentials</p>
            <h3>Behavioral and research preparation</h3>
            <p>Registered Behavior Technician certification and CITI Social/Behavioral Human Research training. Certification details should be checked again before public launch.</p>
          </li>
          <li>
            <p class="eyebrow">Fall 2025</p>
            <h3>AI (Mis)attribution Research</h3>
            <p>Designed and analyzed an online Research Methods II project on how beliefs about agent origin affect social evaluations of identical text-based interactions.</p>
          </li>
          <li>
            <p class="eyebrow">2025</p>
            <h3>PantherNOW Operations</h3>
            <p>Webmaster experience and current website-iteration work. Platform and detailed project documentation remain pending for the final case study.</p>
          </li>
          <li>
            <p class="eyebrow">Behavioral care</p>
            <h3>Behavioral Health Technician / RBT</h3>
            <p>Experience supporting behavioral-health services. The public portfolio keeps client information and confidential care details out of the presentation.</p>
          </li>
          <li>
            <p class="eyebrow">2020–present portfolio</p>
            <h3>Client Website Systems</h3>
            <p>Independent strategy, design, SitePad development, responsive implementation, forms, business email, payments, domain configuration, and launch work.</p>
          </li>
          <li>
            <p class="eyebrow">Independent commerce</p>
            <h3>Shopify Theme Development</h3>
            <p>World Cup Items and VX Nexus: theme development, product systems, art direction, responsive commerce, payment infrastructure, email, domains, and launch.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>
