---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionIntro from '@/components/ui/SectionIntro.astro';
import StudyDiagram from '@/components/home/StudyDiagram.astro';
import Pathway from '@/components/home/Pathway.astro';
import ProjectCard from '@/components/work/ProjectCard.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);

const services = [
  {
    number: '01',
    title: 'Behavioral Research & Strategy',
    copy: 'Research that identifies patterns, barriers, needs, and opportunities before design begins.',
  },
  {
    number: '02',
    title: 'Web Design & Development',
    copy: 'Responsive websites built around clarity, accessibility, performance, and purposeful structure.',
  },
  {
    number: '03',
    title: 'Commerce & Digital Systems',
    copy: 'Shopify theme development and operational systems that make products, services, and decisions easier to understand.',
  },
  {
    number: '04',
    title: 'Data & Content Systems',
    copy: 'Tools that organize information, reveal patterns, and support more informed decisions.',
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Hi, I’m</p>
        <h1 class="hero-name">Juan Lopez</h1>
        <p class="hero-title">Behavior Analyst<br />Researcher &amp; Digital Systems Designer</p>
        <h2 class="hero-message">I study behavior.<br />I design with <em>people</em> in mind.</h2>
        <p class="hero-copy__body">
          My work begins with observation, data, and respect for the person behind every pattern.
          I carry that foundation into research, care, and every digital system I build.
        </p>
        <div class="hero-actions">
          <a class="button button--primary" href="/work/">Explore my work <span aria-hidden="true">↗</span></a>
          <a class="button button--secondary" href="/research/">Read my research <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="portrait-stage">
        <picture>
          <source srcset="/images/hero/juan-portrait.avif" type="image/avif" />
          <source srcset="/images/hero/juan-portrait.webp" type="image/webp" />
          <img src="/images/hero/juan-portrait.webp" width="1600" height="1200" alt="Juan Lopez standing beside a misty mountain lake" fetchpriority="high" decoding="async" />
        </picture>
        <aside class="insight-panel" aria-label="Guiding principles">
          <span class="insight-panel__icon" aria-hidden="true">
            <svg viewBox="0 0 32 32"><path d="M3 16s5-8 13-8 13 8 13 8-5 8-13 8S3 16 3 16Z"></path><circle cx="16" cy="16" r="4"></circle></svg>
          </span>
          <ul>
            <li>Clarity lowers uncertainty.</li>
            <li>Consistency builds trust.</li>
            <li>Good systems respect choice.</li>
          </ul>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--after-hero">
    <div class="page-shell research-spotlight">
      <div>
        <p class="eyebrow">Research Spotlight</p>
        <h2>AI <em>(Mis)attribution</em></h2>
        <p class="research-question">Do people judge the same interaction differently when they believe artificial intelligence is involved?</p>
        <p class="research-summary">
          In an online study, participants rated a conversation as more natural when they believed both speakers were human—even though every condition used the same transcript.
        </p>
        <div class="research-tools" role="group" aria-label="Research tools">
          <span class="tool-label">Qualtrics</span>
          <span class="tool-label">IBM SPSS</span>
          <span class="tool-label">Online study</span>
        </div>
        <div class="research-actions">
          <a class="button button--primary" href="/research/ai-misattribution/">View research summary</a>
          <a class="button button--secondary" href="/research/ai-misattribution/#study-one-design">Explore the method</a>
        </div>
      </div>
      <aside class="research-design-panel" aria-label="Study One design">
        <dl class="study-meta">
          <div><dt>Sample</dt><dd>N = 123</dd></div>
          <div><dt>Conditions</dt><dd>Three</dd></div>
          <div><dt>Term</dt><dd>Fall 2025</dd></div>
        </dl>
        <StudyDiagram />
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="page-shell behavior-statement">
      <div class="behavior-statement__copy">
        <p class="eyebrow">Behavior Analysis</p>
        <h2 class="editorial-heading">Data reveals patterns.<em>Care gives them purpose.</em></h2>
        <p class="behavior-statement__body">
          I am drawn to behavior analysis because it brings care and evidence into the same room. Studying patterns over time can help teams understand what is working, what needs to change, and how support can better reflect the person receiving it.
        </p>
        <p class="behavior-statement__body">
          Data does not replace the human story. It can help us listen more carefully, contribute to individualized decisions, and keep independence, dignity, and informed choice in view.
        </p>
      </div>
      <aside class="care-process" aria-label="Behavior analysis process">
        <ol>
          <li>Observe</li>
          <li>Measure</li>
          <li>Understand</li>
          <li>Adjust</li>
          <li>Review</li>
        </ol>
        <p>Patterns become useful when they lead to thoughtful action.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="approach">
    <div class="page-shell">
      <SectionIntro
        eyebrow="ABA-Informed Design Pathway"
        title="A clearer path from observation to useful change."
        body="Behavioral ideas are translated into everyday design decisions. Technical terms appear only where they add precision."
        align="center"
      />
      <Pathway />
      <p class="source-note">
        The pathway is grounded in behavior-analysis literature on attending, stimulus control, prompting, fading, feedback, and socially meaningful outcomes. It also reflects professional ethics emphasizing dignity, compassion, self-determination, and informed choice. Read the <a href="/approach/">full approach and sources</a>.
      </p>
    </div>
  </section>

  <section class="section" id="work">
    <div class="page-shell">
      <SectionIntro
        eyebrow="Selected Work"
        title="Different systems. One careful foundation."
        body="Research, client services, commerce, and data work shaped around the real decisions people need to make."
      />
      <div class="work-grid">
        {projects.map((project, index) => (
          <ProjectCard project={project} size={index < 2 ? 'medium' : 'small'} />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-shell ecosystem">
      <div>
        <p class="eyebrow">Project Ecosystem</p>
        <h2>One industry ecosystem. Three different digital problems.</h2>
      </div>
      <div class="ecosystem-list">
        <article>
          <h3>Sharper Image Services</h3>
          <p>Centralizing a broad landscaping and land-service offering, including inquiry and payment tasks.</p>
        </article>
        <article>
          <h3>SIS Florida</h3>
          <p>Explaining sod varieties and installation for residential and commercial audiences.</p>
        </article>
        <article>
          <h3>SIS Asphalt</h3>
          <p>Creating a deeper service, trust, education, and quote-request architecture.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="page-shell">
      <SectionIntro
        eyebrow="Services"
        title="Careful thinking, carried through to implementation."
        body="Engagements can begin with research, a website, a commerce system, or a need to make complex information more usable."
      />
      <div class="service-grid">
        {services.map((service) => (
          <article class="service-card">
            <span class="service-card__number">{service.number}</span>
            <h3>{service.title}</h3>
            <p>{service.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="page-shell about-preview">
      <div class="about-preview__visual">
        <picture>
          <source srcset="/images/portraits/about-observation-systems.avif" type="image/avif" />
          <source srcset="/images/portraits/about-observation-systems.webp" type="image/webp" />
          <img src="/images/portraits/about-observation-systems.webp" width="1200" height="1500" alt="Research notebook and paper layers arranged on a light surface" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="about-preview__content">
        <p class="eyebrow">About Juan</p>
        <h2>Behavior analysis comes first.</h2>
        <p>
          Juan's research, design, development, e-commerce, and data work share the same starting point: observe carefully, respect individual differences, communicate clearly, and improve systems without losing sight of the person.
        </p>
        <p>
          He builds SitePad client websites and develops Shopify themes, while carrying a behavior-analytic foundation into research and information design.
        </p>
        <a class="text-link" href="/about/">Read more about Juan <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
