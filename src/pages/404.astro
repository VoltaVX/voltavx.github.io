---
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLink from '../components/ActionLink.astro';
import { withBase } from '../lib/links';
---
<BaseLayout title="Page not found" description="This page could not be found. Return to the VoltaVX portfolio." noindex>
  <section class="container section stack">
    <p class="eyebrow">404 / A small detour</p>
    <h1 class="display">Let’s get you<br/><em>back on track.</em></h1>
    <p class="lead">This page could not be found. The portfolio is a good place to start again.</p>
    <div class="actions"><ActionLink href={withBase('/')}>Back to portfolio</ActionLink></div>
  </section>
</BaseLayout>
