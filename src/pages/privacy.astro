---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy — Juan Lopez" description="Privacy information for voltavx.com.">
  <header class="page-hero">
    <div class="page-shell page-hero__inner">
      <p class="eyebrow">Privacy</p>
      <h1>A small site with a small data footprint.</h1>
      <p class="page-hero__lede">This portfolio is designed as a static website with minimal client-side code.</p>
    </div>
  </header>
  <section class="section--tight">
    <div class="page-shell case-layout">
      <aside class="case-meta">
        <p class="verification-box">Last reviewed July 26, 2026.</p>
      </aside>
      <div class="case-content">
        <section>
          <h2>Information collection</h2>
          <p>This site does not include an account system, advertising tracker, or behavior-profiling script. The contact form prepares an email in your own email application; it does not submit information to a portfolio database.</p>
        </section>
        <section>
          <h2>Hosting and external links</h2>
          <p>GitHub Pages may process ordinary server request data needed to deliver the site. Links to live projects and research sources lead to third-party websites with their own privacy practices.</p>
        </section>
        <section>
          <h2>Sensitive information</h2>
          <p>Do not send confidential health, client, or treatment information through the public contact link.</p>
        </section>
        <section>
          <h2>Questions</h2>
          <p>Email <a href="mailto:voltavxofficial@gmail.com">voltavxofficial@gmail.com</a> with privacy questions.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
