---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Juan Lopez"
  description="Contact Juan Lopez about behavioral research, web design and development, Shopify themes, commerce, and data-content systems."
>
  <header class="page-hero">
    <div class="page-shell page-hero__inner">
      <p class="eyebrow">Contact</p>
      <h1>Start with the problem you are trying to understand.</h1>
      <p class="page-hero__lede">
        Share the audience, the current barrier, and what a useful outcome would look like. A clear scope can grow from there.
      </p>
    </div>
  </header>

  <section class="section--tight">
    <div class="page-shell contact-layout">
      <div>
        <div class="contact-details">
          <a href="mailto:voltavxofficial@gmail.com">
            <strong>Email directly</strong>
            <span>voltavxofficial@gmail.com</span>
          </a>
          <a href="https://www.linkedin.com/in/juan-lopez04" target="_blank" rel="noreferrer">
            <strong>LinkedIn</strong>
            <span>Connect with Juan</span>
          </a>
          <a href="/work/">
            <strong>Review the work</strong>
            <span>Case studies, research, and systems</span>
          </a>
        </div>
      </div>
      <form class="contact-form" data-contact-form>
        <div class="form-field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="email">Your email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="form-field">
          <label for="topic">What would you like to discuss?</label>
          <select id="topic" name="topic">
            <option>Behavioral research and strategy</option>
            <option>Web design and development</option>
            <option>Shopify theme or commerce system</option>
            <option>Data or content system</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="form-field">
          <label for="message">A little context</label>
          <textarea id="message" name="message" required aria-describedby="message-note"></textarea>
          <p id="message-note" class="form-note">Please do not include confidential health or client information.</p>
        </div>
        <button class="button button--primary" type="submit">Prepare message <span aria-hidden="true">↗</span></button>
        <p class="form-note" aria-live="polite" data-form-status>Filling out this form prepares your message for 1-click sending.</p>
        
        <div class="contact-actions" data-contact-actions hidden>
          <p class="form-note form-note--highlight">Choose your preferred method to send:</p>
          <div class="contact-actions__buttons">
            <a class="button button--primary" data-mailto-link href="#" target="_blank">
              Open Mail App <span aria-hidden="true">✉️</span>
            </a>
            <a class="button button--secondary" data-gmail-link href="#" target="_blank" rel="noreferrer">
              Open in Gmail Web <span aria-hidden="true">🌐</span>
            </a>
            <button class="button button--secondary" data-copy-btn type="button">
              Copy Email & Text <span aria-hidden="true">📋</span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const actionsBox = document.querySelector<HTMLElement>('[data-contact-actions]');
  const mailtoLink = document.querySelector<HTMLAnchorElement>('[data-mailto-link]');
  const gmailLink = document.querySelector<HTMLAnchorElement>('[data-gmail-link]');
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-btn]');

  let preparedText = '';

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const values = new FormData(form);
    const topic = (values.get('topic') as string) ?? 'Project';
    const name = (values.get('name') as string) ?? '';
    const email = (values.get('email') as string) ?? '';
    const message = (values.get('message') as string) ?? '';

    const subjectText = `Portfolio inquiry: ${topic}`;
    const bodyText = `Name: ${name}\r\nEmail: ${email}\r\nTopic: ${topic}\r\n\r\nMessage:\r\n${message}`;

    preparedText = `To: voltavxofficial@gmail.com\r\nSubject: ${subjectText}\r\n\r\n${bodyText}`;

    const mailtoUrl = `mailto:voltavxofficial@gmail.com?subject=${encodeURIComponent(subjectText)}&body=${encodeURIComponent(bodyText)}`;
    const gmailUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=voltavxofficial@gmail.com&su=${encodeURIComponent(subjectText)}&body=${encodeURIComponent(bodyText)}`;

    if (mailtoLink) mailtoLink.href = mailtoUrl;
    if (gmailLink) gmailLink.href = gmailUrl;
    if (actionsBox) actionsBox.hidden = false;

    if (status) status.textContent = 'Message prepared! Choose how you would like to send it below:';

    // Attempt direct trigger
    window.location.href = mailtoUrl;
  });

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(preparedText);
      copyBtn.textContent = 'Copied to Clipboard! ✓';
      setTimeout(() => {
        copyBtn.innerHTML = 'Copy Email & Text <span aria-hidden="true">📋</span>';
      }, 3000);
    } catch {
      alert('Copied message text:\n\n' + preparedText);
    }
  });
</script>
