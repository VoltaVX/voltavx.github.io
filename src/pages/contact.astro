---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { PUBLIC_EMAIL_ADDRESS, PUBLIC_PHONE_NUMBER } from 'astro:env/client';

const emailAddress = PUBLIC_EMAIL_ADDRESS.trim();
if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailAddress)) {
  throw new Error('PUBLIC_EMAIL_ADDRESS must be a valid email address.');
}
const phoneNumber = PUBLIC_PHONE_NUMBER.replace(/[^0-9+]/g, '');
const initialMailtoUrl = `mailto:${emailAddress}?subject=${encodeURIComponent('Portfolio inquiry')}`;
---

<BaseLayout
  title="Contact — Juan Lopez"
  description="Contact Juan Lopez about behavioral research, web design and development, Shopify themes, commerce, and data-content systems."
>
  <header class="page-hero">
    <div class="page-shell page-hero__inner">
      <p class="eyebrow">Contact</p>
      <h1>Start with the problem you are trying to understand.</h1>
      <p class="page-hero__lede">
        Share the audience, the current barrier, and what a useful outcome would look like. A clear scope can grow from there.
      </p>
    </div>
  </header>

  <section class="section--tight">
    <div class="page-shell contact-layout">
      <div>
        <div class="contact-details">
          <a href={initialMailtoUrl}>
            <strong>Email directly</strong>
            <span>{emailAddress}</span>
          </a>
          <a href="https://www.linkedin.com/in/juan-lopez04" target="_blank" rel="noopener noreferrer">
            <strong>LinkedIn</strong>
            <span>Connect with Juan</span>
          </a>
          <a href="/work/">
            <strong>Review the work</strong>
            <span>Case studies, research, and systems</span>
          </a>
        </div>
      </div>
      <form class="contact-form" data-contact-form data-email={emailAddress} data-phone={phoneNumber} autocomplete="on">
        <div class="form-field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
        </div>
        <div class="form-field">
          <label for="email">Your email</label>
          <input id="email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required />
        </div>
        <div class="form-field">
          <label for="topic">What would you like to discuss?</label>
          <select id="topic" name="topic">
            <option>Behavioral research and strategy</option>
            <option>Web design and development</option>
            <option>Shopify theme or commerce system</option>
            <option>Data or content system</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="form-field">
          <label for="message">A little context</label>
          <textarea id="message" name="message" minlength="10" maxlength="3000" required aria-describedby="message-note"></textarea>
          <p id="message-note" class="form-note">Up to 3,000 characters. Please do not include confidential health or client information.</p>
        </div>

        <div class="contact-actions" data-contact-actions>
          <p class="form-note form-note--highlight">Send your message with 1 click using your preferred app:</p>
          <div class="contact-actions__buttons">
            <a class="button button--primary" data-action="mailto" href={initialMailtoUrl}>
              Open Default Mail App <span aria-hidden="true">✉️</span>
            </a>
            {phoneNumber && (
              <a class="button button--primary" data-action="sms" href={`sms:${phoneNumber}`}>
                Open Text App (SMS) <span aria-hidden="true">💬</span>
              </a>
            )}
            <a class="button button--secondary" data-action="gmail" href="#" target="_blank" rel="noopener noreferrer">
              Open in Gmail Web <span aria-hidden="true">🌐</span>
            </a>
            <button class="button button--secondary" data-action="copy" type="button">
              Copy Email & Text <span aria-hidden="true">📋</span>
            </button>
          </div>
          <p class="form-note">Native email asks your browser and operating system to open their configured mail handler. Nothing opened? Check your default email app, use Gmail Web, or copy the message.</p>
          <p class="form-note" aria-live="polite" data-form-status></p>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  import '../scripts/contact';
</script>
