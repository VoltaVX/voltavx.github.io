---
const nav = [
  { href: '/work/', label: 'Work' },
  { href: '/research/', label: 'Research' },
  { href: '/approach/', label: 'Approach' },
  { href: '/services/', label: 'Services' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const current = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="nav-shell">
    <a class="brand-mark" href="/" aria-label="Juan Lopez, home">JL<span>.</span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={current === item.href || (item.href !== '/' && current.startsWith(item.href)) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../../scripts/header';
</script>
