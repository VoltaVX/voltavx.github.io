---
import type { CollectionEntry } from 'astro:content';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import ProjectVisual from '@/components/ui/ProjectVisual.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  size?: 'lead' | 'medium' | 'small';
}
const { project, size = 'small' } = Astro.props;
const data = project.data;
---

<article class:list={['project-card', `project-card--${size}`, data.status === 'Under Construction' && 'project-card--building']}>
  <a class="project-card__visual" href={`/work/${data.slug}/`} aria-label={`View ${data.title} case study`}>
    <ProjectVisual cover={data.cover} alt={data.coverAlt} eager={data.featuredOrder === 1} />
  </a>
  <div class="project-card__content">
    <div class="project-card__topline">
      <p class="eyebrow">{data.category}</p>
      <StatusBadge status={data.status} />
    </div>
    <h3><a href={`/work/${data.slug}/`}>{data.title}</a></h3>
    <p>{data.summary}</p>
    <dl class="project-card__meta">
      <div><dt>Role</dt><dd>{data.role}</dd></div>
      <div><dt>Platform</dt><dd>{data.platform}</dd></div>
      <div><dt>When</dt><dd>{data.approximateProjectYear}</dd></div>
    </dl>
    {data.status === 'Under Construction' && (
      <progress class="build-progress" aria-label="Concept development progress" max="100" value="35">35%</progress>
    )}
    <div class="project-card__actions">
      <a class="text-link" href={`/work/${data.slug}/`}>
        {data.status === 'Under Construction' ? 'View concept' : 'View case study'} <span aria-hidden="true">↗</span>
      </a>
      {data.liveUrl && <a class="text-link text-link--muted" href={data.liveUrl} target="_blank" rel="noreferrer">Live website <span aria-hidden="true">↗</span></a>}
    </div>
  </div>
</article>
