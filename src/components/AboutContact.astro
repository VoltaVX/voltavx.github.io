---
import SectionHeading from './SectionHeading.astro';
import ActionLink from './ActionLink.astro';
import { withBase } from '../lib/links';

const tools = ['SitePad', 'WordPress', 'Shopify', 'Astro', 'Qualtrics', 'IBM SPSS'];
---

<section id="about" class="section container about-grid" aria-label="About Juan">
  <div class="about-copy">
    <SectionHeading eyebrow="About Juan" title="Behavior analysis comes first." />
    <div class="prose">
      <p>My background in behavior analysis shapes how I approach every project. I look at what people need and where a system creates unnecessary friction. I begin with the same principles: observe carefully, define clearly, respect individual differences, and keep the person in view.</p>
      <p>I build client websites with SitePad and WordPress, develop Shopify themes, and use Astro for focused, lightweight websites. Across research, design, commerce, and data work, my goal is to make experiences clear, useful, and responsive to the people who use them.</p>
    </div>
    <ul role="list" class="tool-list" aria-label="Tools I use">
      {tools.map((tool) => <li>{tool}</li>)}
    </ul>
    <div class="actions about-actions">
      <a class="text-link" href={withBase("/about/")}>Read more about Juan <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={withBase("/resume/")}>View résumé <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <img
    src={withBase('/images/portraits/juan-writing-notebook-v2.webp')}
    width="1122"
    height="1402"
    alt="Juan writing in a notebook."
    loading="lazy"
    decoding="async"
  />
</section>

<section id="contact" class="section contact-section" aria-label="Contact Juan">
  <div class="container contact-panel">
    <SectionHeading
      eyebrow="A thoughtful next step"
      title="Build something people can understand and trust."
    />
    <ActionLink href="mailto:voltavxofficial@gmail.com">Start a conversation</ActionLink>
  </div>
</section>
