---
import ActionLink from './ActionLink.astro';
import { withBase } from '../lib/links';
---
<section class="container portfolio-introduction" aria-labelledby="portfolio-title">
  <div class="portfolio-hero">
    <div class="intro-copy hero-copy">
      <p class="eyebrow">Juan Lopez</p>
      <h1 class="display" id="portfolio-title">I study behavior. I design with <em>people</em> in mind.</h1>
      <p class="lead">Behavior research, thoughtful design, and digital systems built around people.</p>
      <div class="actions">
        <ActionLink href={withBase('/#work')}>Explore my work</ActionLink>
        <a class="text-link" href={withBase('/research/')}>Read my research <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="discipline-panel">
      <ul role="list" class="discipline-strip" aria-label="Areas of practice">
        <li>Behavior research</li>
        <li>Digital experiences</li>
        <li>Data &amp; context</li>
      </ul>
    </div>
    <figure class="hero-portrait">
      <img
        src={withBase('/images/hero/juan-hero-v2.webp')}
        alt="Juan Lopez standing beside a quiet, misty mountain lake."
        width="1586"
        height="992"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="portrait-caption">Observe. Understand. Build.</figcaption>
    </figure>
  </div>
</section>
