---
interface Props {
  cover: string;
  alt: string;
  eager?: boolean;
}
const { cover, alt, eager = false } = Astro.props;
---

<picture>
  <source srcset={`${cover}.avif`} type="image/avif" />
  <source srcset={`${cover}.webp`} type="image/webp" />
  <img
    src={`${cover}.webp`}
    alt={alt}
    width="1600"
    height="960"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</picture>
